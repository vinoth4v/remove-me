# Copy to .env.local and fill in. Never commit .env.local.

# Neon connection string (pooled). Neon dashboard -> Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Only when self-hosting behind a proxy, or serving a production build on
# localhost. Vercel deployments infer the host and do not need this.
# AUTH_TRUST_HOST="true"

# The single operator. Only this address can sign in.
WERFT_USER_EMAIL="you@example.com"

# Generate with: pnpm hash-password '<your password>'
# The hash contains $ characters, and Next's env parser expands $... in
# .env.local even inside single quotes — an unescaped hash silently becomes
# the literal string "scrypt" and every sign-in fails. Escape each $ as \$:
#   WERFT_PASSWORD_HASH='scrypt\$65536\$8\$1\$<salt>\$<hash>'
# Vercel dashboard env vars are not parsed this way and need no escaping.
WERFT_PASSWORD_HASH=""

# Only present when the app was scaffolded with --with-s3. Werft mints these:
# a bucket and a bucket-scoped IAM user, so this key can touch this bucket and
# nothing else. Never the AWS admin key.
# S3_BUCKET=""
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Model access for the app itself, through the Kompass gateway. Set on every
# scaffolded app, whether or not it uses AI — an app that never calls a model
# simply never reads them. src/kompass.ts is the only thing that should.
KOMPASS_BASE_URL="https://kompass.vinoth4v.workers.dev"
KOMPASS_TOKEN=""

# Encrypts identity-vault values at rest (AES-256-GCM). Losing it makes the
# vault unreadable. Generate with: openssl rand -base64 32
IDENTITY_ENCRYPTION_KEY=""

# Shared secret for /api/cron/verify. Vercel Cron sends it automatically as a
# bearer token when this env var exists on the project.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
